# Chat + Whisper STT (required for this project)
VITE_GROQ_API_KEY=

# Optional chat providers
VITE_GEMINI_API_KEY=
VITE_OPENAI_API_KEY=

# Live weather (https://openweathermap.org/api)
VITE_OPENWEATHER_API_KEY=

# Web search (https://tavily.com) — DuckDuckGo is used if this is empty
VITE_TAVILY_API_KEY=

# Optional Google Programmable Search (needs both)
VITE_GOOGLE_CSE_KEY=
VITE_GOOGLE_CSE_ID=

# Optional future backend, e.g. http://localhost:3001/api/chat
# Leave empty so Groq is used.
VITE_AI_BACKEND_URL=
